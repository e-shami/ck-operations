# Required for dev, build, and production. Never commit real values.
# Use a Resend-verified sender address; submissions are sent only to this inbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public fallback address displayed in the form and footer, separate from the private inbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# Exact browser origin, also used for same-origin checks. HTTPS except local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reserved for future booking support; currently unused (form only).
NEXT_PUBLIC_BOOKING_URL=
